Set Shell bash
Set FontFamily "Geist Mono"
Set FontSize 30
Set LineHeight 1.0
Set Width 2560
Set Height 1440
Set Padding 40
Set TypingSpeed 38ms
Set CursorBlink false
Set Framerate 30
Set WaitTimeout 30s
Set Theme { "name": "Inboxjot", "background": "#141414", "foreground": "#EDEDED", "selection": "#3A3A3A", "cursor": "#EDEDED", "black": "#1C1C1C", "red": "#F25F54", "green": "#46C98B", "yellow": "#F2B84B", "blue": "#5AA9F7", "magenta": "#C38CF2", "cyan": "#4CC9C0", "white": "#EDEDED", "brightBlack": "#7A7A7A", "brightRed": "#FF7A6E", "brightGreen": "#6BDDA6", "brightYellow": "#F7CC72", "brightBlue": "#82BFFA", "brightMagenta": "#D6AAF7", "brightCyan": "#73DAD3", "brightWhite": "#FFFFFF" }
